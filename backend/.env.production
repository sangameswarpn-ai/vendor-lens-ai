# Production Environment Template
# Copy this to .env and fill in your production values

# PostgreSQL Database (Use Render or other managed database)
DATABASE_URL=your_production_database_url_here

# Server Settings
PORT=5000
NODE_ENV=production

# CORS Configuration (Set to your frontend deployment URL)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# JWT Authentication (Generate a strong random secret)
JWT_SECRET=generate-a-strong-random-secret-key-here
JWT_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=uploads
